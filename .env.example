# One server-only flag switches authentication, API state, and integrations.
DEMO_MODE=true

# Live mode: set DEMO_MODE=false and configure these values.
# Include the backend's API prefix in this URL. It is never exposed to the browser.
# For Obelisk on port 4000, use http://localhost:4000/api and restart Portal.
PORTAL_API_URL=http://localhost:3000/api
APP_VERSION=1.0.0
# Optional canonical public origin when behind a reverse proxy, e.g. https://portal.example.com
PORTAL_APP_ORIGIN=
# npm run share sets the temporary app origin automatically, without editing this file.
# Optional sharing overrides (normal npm run dev is unchanged).
SHARE_PORT=3001
SHARE_ALLOWED_EMAILS=
# Required in live mode: generate with `openssl rand -base64 48`.
SESSION_SECRET=
FIREBASE_WEB_API_KEY=

# Optional resumable setup in live mode; backend must implement /onboarding.
# Demo mode always includes setup when the module is enabled.
PORTAL_ONBOARDING_ENABLED=false

# Optional live Socket.IO server. Ticket endpoint is /realtime/tickets on the API.
# Remote browsers need a reachable HTTPS URL here, not your computer's localhost.
PORTAL_SOCKET_URL=http://localhost:3000

# Optional Firebase Messaging. These Firebase web configuration values are public.
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_PUBLIC_KEY=

# Optional public analytics project key; SDK loads only after explicit consent.
AMPLITUDE_API_KEY=
